# Tracebow — example environment.
# Copy this file to .env and edit values for your deployment.
#
# Only lines that are uncommented take effect. All values below are the
# defaults used if the variable is missing, so commenting a line is safe.

# ----------------------------------------------------------------------------
# Image / version
# ----------------------------------------------------------------------------
# TRACEBOW_VERSION=latest
#
# Registry namespace for the published images. Defaults to ghcr.io/<repo-owner>
# (ghcr.io/hyurii for this repo), matching .github/workflows/publish.yml.
# Set this to ghcr.io/<your-org-or-user> if you publish under a different owner.
# TRACEBOW_REGISTRY=ghcr.io/hyurii

# ----------------------------------------------------------------------------
# Ports exposed on the host
# ----------------------------------------------------------------------------
# API_PORT=8080
# PORTAL_PORT=3000
# POSTGRES_PORT=5432        # dev compose only
# REDIS_PORT=6379           # dev compose only
# OLLAMA_PORT=11434         # dev compose only

# ----------------------------------------------------------------------------
# Postgres (telemetry store)
# ----------------------------------------------------------------------------
# POSTGRES_USER=tracebow
# POSTGRES_PASSWORD=tracebow
# POSTGRES_DB=tracebow

# ----------------------------------------------------------------------------
# AI runtime
# ----------------------------------------------------------------------------
# OLLAMA_ENABLED=true               # prod default: on. Dev default: off.
# OLLAMA_MODEL=llama3.2:3b          # chat / novel-error triage
# OLLAMA_MODEL_RCA=phi4-mini        # deep RCA / stacktrace reasoning

# ----------------------------------------------------------------------------
# Celery
# ----------------------------------------------------------------------------
# CELERY_WORKER_CONCURRENCY=4
# CELERY_RCA_RATE_LIMIT=10/m

# ----------------------------------------------------------------------------
# Wiki
# ----------------------------------------------------------------------------
# WIKI_DEFAULT_BRANCH=main
#
# Symmetric key used to encrypt deploy keys at rest in Postgres. Change this
# in production and keep it in a secret manager. Rotating it invalidates any
# stored backup deploy key (the UI will prompt to re-enter it).
# WIKI_SECRET_KEY=tracebow-dev-unsafe-key-please-override

# ----------------------------------------------------------------------------
# Integrations (all optional — leave blank to disable the corresponding tool)
# ----------------------------------------------------------------------------
# JENKINS_URL=
# JENKINS_USER=
# JENKINS_API_TOKEN=

# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
