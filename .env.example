# Tracebow Configuration
# Copy to .env and fill in your values

# Optional: merge docker-compose.gpu.yml so Ollama uses NVIDIA GPUs on Linux
# (requires nvidia-container-toolkit). Leave unset for CPU-only (default).
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# LLM - Ollama endpoint (local). docker-compose pulls both models on first up.
OLLAMA_BASE_URL=http://ollama:11434
# Fast: chat, Jira/Slack RAG summarization
OLLAMA_MODEL=llama3.2:3b
# Deep: stack traces, coding, pipeline root-cause (Jenkins/GitHub RCA paths)
OLLAMA_MODEL_RCA=phi4-mini

# Vector Database - Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=tracebow_embeddings

# Graph Database - Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Jenkins (for ingestion + MCP)
JENKINS_URL=https://jenkins.example.com
JENKINS_API_TOKEN=your-token
JENKINS_USER=ci-bot

# GitHub (for ingestion + MCP)
GITHUB_TOKEN=ghp_xxxx
GITHUB_WEBHOOK_SECRET=your-secret

# Jira (for ingestion + MCP)
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=agent@company.com
JIRA_API_TOKEN=your-atlassian-token

# Slack (for ingestion + MCP)
SLACK_BOT_TOKEN=xoxb-xxxx
SLACK_SIGNING_SECRET=your-signing-secret

# Portal / API
API_HOST=0.0.0.0
API_PORT=8080
PORTAL_PORT=3000
